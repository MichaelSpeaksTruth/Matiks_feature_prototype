# ─────────────────────────────────────────────────────────────────────────────
# Matiks Backend — Environment Variables
#
# Setup:
#   cp .env.example .env
#   # then fill in GROQ_API_KEY with your real key
#
# ⚠️  NEVER commit the .env file — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq API ──────────────────────────────────────────────────────────────────
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_REAL_GROQ_API_KEY

# ── Groq Vision Model ─────────────────────────────────────────────────────────
# IMPORTANT: Must be a vision-capable (multimodal) model.
#
#   ✅ Recommended (multimodal, 128 k context):
#      llama-3.2-90b-vision-preview
#
# Full list of vision models: https://console.groq.com/docs/vision
GROQ_MODEL=llama-3.2-90b-vision-preview

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set this to your Vercel deployment URL once the frontend is deployed.
# Example: https://matiks-moderation.vercel.app
# (All *.vercel.app origins are also covered by a regex in main.py)
FRONTEND_URL=http://localhost:3000
